DJANGO_SECRET_KEY=''
DJANGO_DEBUG=0
ALLOWED_HOSTS=

DATABASE_URL=''

REDIS_HOST=redis
REDIS_PORT=6379

# --- STRIPE BILLING CONFIGURATION ---
STRIPE_PUBLIC_KEY = ''
STRIPE_SECRET_KEY = ''
STRIPE_PRO_PRICE_ID = ''
STRIPE_WEBHOOK_SECRET = ''

# --- ML INFERENCE ---
ML_MODEL_VERSION=
# ML_MODEL_PATH=/app/backend/core_saas/predictions/ml_models/soil_model.pkl
ML_TASK_SOFT_TIME_LIMIT=120
ML_TASK_TIME_LIMIT=150

# --- LOGGING & MONITORING ---
# json (production) or text (readable local logs)
LOG_FORMAT=json

# Sentry: leave SENTRY_DSN empty to disable (local dev, CI)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0

# --- CELERY ---
CELERY_BROKER_URL = "redis://redis:6379/0"
CELERY_RESULT_BACKEND = "redis://redis:6379/0"